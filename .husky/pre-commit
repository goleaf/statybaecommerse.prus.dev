#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

set -eu

printf '\n▶ Running Pint on dirty files...\n'
vendor/bin/pint --dirty

# Restage files that Pint may have modified
if ! git diff --quiet; then
    git add --update
fi

STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\\.php$' || true)

if [ -n "$STAGED_PHP_FILES" ]; then
    printf '\n▶ Running PHPStan on staged PHP files...\n'
    vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G --no-progress $STAGED_PHP_FILES
else
    printf '\n▶ No staged PHP files detected; skipping PHPStan.\n'
fi
