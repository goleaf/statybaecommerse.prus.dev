#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

set -eu

TMP_STAGED_PHP=$(mktemp)
trap 'rm -f "$TMP_STAGED_PHP"' EXIT

git diff --cached --name-only --diff-filter=ACMR -- '*.php' > "$TMP_STAGED_PHP"

if [ ! -s "$TMP_STAGED_PHP" ]; then
    exit 0
fi

PINT="vendor/bin/pint"
PHPSTAN="vendor/bin/phpstan"

if [ ! -x "$PINT" ]; then
    echo "Laravel Pint executable not found at $PINT. Run 'composer install' to install project dependencies."
    exit 1
fi

if [ ! -x "$PHPSTAN" ]; then
    echo "PHPStan executable not found at $PHPSTAN. Run 'composer install' to install project dependencies."
    exit 1
fi

echo "Running Pint (dirty mode) on staged PHP files..."
"$PINT" --dirty

while IFS= read -r file; do
    if [ -n "$file" ]; then
        git add -- "$file"
    fi
done < "$TMP_STAGED_PHP"

echo "Running PHPStan on staged PHP files..."
"$PHPSTAN" analyse -c phpstan.neon --memory-limit=1G --no-progress --paths-file="$TMP_STAGED_PHP"
