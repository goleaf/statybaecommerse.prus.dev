#!/usr/bin/env sh
# Execute pre-commit quality gates with Husky's modern shim already providing PATH access.

set -eu

TMP_STAGED_PHP=$(mktemp)
TMP_STAGED_JS=$(mktemp)
TMP_STAGED_PRETTIER=$(mktemp)
trap 'rm -f "$TMP_STAGED_PHP" "$TMP_STAGED_JS" "$TMP_STAGED_PRETTIER"' EXIT

git diff --cached --name-only --diff-filter=ACMR -- '*.php' > "$TMP_STAGED_PHP"
git diff --cached --name-only --diff-filter=ACMR -z -- '*.js' '*.jsx' '*.ts' '*.tsx' > "$TMP_STAGED_JS"
git diff --cached --name-only --diff-filter=ACMR -z -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.css' '*.scss' '*.json' '*.md' > "$TMP_STAGED_PRETTIER"

PINT="vendor/bin/pint"
PHPSTAN="vendor/bin/phpstan"
ESLINT="node_modules/.bin/eslint"
PRETTIER="node_modules/.bin/prettier"

if [ -s "$TMP_STAGED_PHP" ]; then
    if [ ! -x "$PINT" ]; then
        echo "Laravel Pint executable not found at $PINT. Run 'composer install' to install project dependencies."
        exit 1
    fi

    echo "Running Pint (dirty mode) on staged PHP files..."
    "$PINT" --dirty

    while IFS= read -r file; do
        if [ -n "$file" ]; then
            git add -- "$file"
        fi
    done < "$TMP_STAGED_PHP"

    if [ ! -x "$PHPSTAN" ]; then
        echo "PHPStan executable not found at $PHPSTAN. Run 'composer install' to install project dependencies."
        exit 1
    fi

    echo "Running PHPStan on staged PHP files..."
    "$PHPSTAN" analyse -c phpstan.neon --memory-limit=1G --no-progress --paths-file="$TMP_STAGED_PHP"
fi

if [ -s "$TMP_STAGED_PRETTIER" ]; then
    if [ ! -x "$PRETTIER" ]; then
        echo "Prettier executable not found at $PRETTIER. Run 'npm install' to install project dependencies."
        exit 1
    fi

    echo "Running Prettier on staged assets..."
    xargs -0 "$PRETTIER" --write --ignore-unknown < "$TMP_STAGED_PRETTIER"
    xargs -0 git add -- < "$TMP_STAGED_PRETTIER"
fi

if [ -s "$TMP_STAGED_JS" ]; then
    if [ ! -x "$ESLINT" ]; then
        echo "ESLint executable not found at $ESLINT. Run 'npm install' to install project dependencies."
        exit 1
    fi

    echo "Running ESLint on staged JavaScript and TypeScript files..."
    xargs -0 "$ESLINT" --max-warnings=0 --fix < "$TMP_STAGED_JS"
    xargs -0 git add -- < "$TMP_STAGED_JS"
fi
