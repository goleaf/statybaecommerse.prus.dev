#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

set -e

TMP_STAGED_PHP=$(mktemp)
trap 'rm -f "$TMP_STAGED_PHP"' EXIT

git diff --cached --name-only --diff-filter=ACMR -- '*.php' > "$TMP_STAGED_PHP"

if [ ! -s "$TMP_STAGED_PHP" ]; then
    exit 0
fi

echo "Running Pint (dirty mode) on staged PHP files..."
vendor/bin/pint --dirty

while IFS= read -r file; do
    if [ -n "$file" ]; then
        git add "$file"
    fi
done < "$TMP_STAGED_PHP"

echo "Running PHPStan on staged PHP files..."
EXIT_CODE=0
while IFS= read -r file; do
    if [ -n "$file" ]; then
        if ! vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G --no-progress "$file"; then
            EXIT_CODE=1
            break
        fi
    fi
done < "$TMP_STAGED_PHP"

exit $EXIT_CODE
