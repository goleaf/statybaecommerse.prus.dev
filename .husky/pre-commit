#!/bin/sh
set -eu

if [ ! -x vendor/bin/pint ] || [ ! -x vendor/bin/phpstan ]; then
    printf '\033[1;31mRequired QA tools are missing. Run composer install before committing.\033[0m\n' >&2
    exit 1
fi

printf '\n\033[1;34m→ Running Laravel Pint (fast check)\033[0m\n'
vendor/bin/pint --test --dirty

PHP_DIFF=$(git diff --name-only --cached -- '*.php' '*.pest' '*.phpt')
if [ -n "$PHP_DIFF" ]; then
    printf '\n\033[1;34m→ Running PHPStan (fast check)\033[0m\n'
    git diff --name-only --cached -z -- '*.php' '*.pest' '*.phpt' \
        | xargs -0 vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G --no-progress
else
    printf '\n\033[0;33mNo staged PHP files detected; skipping PHPStan.\033[0m\n'
fi
