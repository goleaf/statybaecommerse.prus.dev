# Ensure Laravel runs in dedicated testing environment.
APP_ENV=testing
APP_DEBUG=true

# Force in-memory caching layers for deterministic behaviour.
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Keep logging simple during tests.
LOG_CHANNEL=stack

# Use SQLite in-memory database for isolated test execution.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Provide a default application URL for browser-based test runners.
APP_URL=http://127.0.0.1:8000
