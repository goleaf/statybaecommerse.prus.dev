# Testing environment configuration tailored for SQLite usage in CI.
APP_ENV=testing
APP_DEBUG=true
APP_KEY=
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite

BROADCAST_DRIVER=log
MAIL_MAILER=log
FILESYSTEM_DISK=local
