{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "laravel-loop-mcp": {
            "command": "php",
            "args": [
                "artisan",
                "loop:mcp:start"
            ]
        },
        "clockwork": {
            "command": "npx",
            "args": [
                "-y",
                "clockwork-mcp"
            ]
        }
    }
}
