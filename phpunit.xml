<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="storage/app/coverage/cache"
         colors="true"
         cacheResult="true"
         executionOrder="defects"
         beStrictAboutTestsThatDoNotTestAnything="false"
         beStrictAboutOutputDuringTests="false">
    <extensions>
        <!-- PHPUnit 11 expects extension hooks to be declared as bootstrap entries rather than legacy <extension> nodes. -->
        <bootstrap class="Tests\Diagnostics\Coverage\MinimumCoverageExtension">
            <parameter name="threshold" value="65"/>
        </bootstrap>
        <bootstrap class="Tests\Support\Coverage\CoverageThresholdExtension">
            <parameter name="minCoverage" value="70"/>
        </bootstrap>
    </extensions>
    <testsuites>
        <testsuite name="Unit">
            <!-- Keep the unit suite focused on utility and service tests to avoid duplicate class execution. -->
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <!-- Include dedicated model tests to ensure coverage for Eloquent scopes and helpers without overlapping other suites. -->
        <testsuite name="Models">
            <directory suffix="Test.php">tests/Models</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">tests/Feature</directory>
            <directory suffix="Test.php">tests/Admin</directory>
        </testsuite>
        <testsuite name="Performance">
            <directory suffix="Test.php">tests/Performance</directory>
        </testsuite>
    </testsuites>
    <logging>
        <!-- Ensure CI always collects a JUnit report so GitHub records deterministic statuses. -->
        <junit outputFile="junit.xml"/>
    </logging>
    <source>
        <include>
            <directory>app/Models</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <!-- Use in-memory SQLite for stable, fast tests -->
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- Use DELETE journal mode for broader FS compatibility during CI/CLI -->
        <env name="DB_JOURNAL_MODE" value="delete"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="ACTIVITY_LOGGER_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="LARAVEL_PARALLEL_TESTING_WITHOUT_DATABASES" value="1"/>
        <env name="SKIP_FILAMENT_BOOT" value="1"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Avoid SQLite write-contention across processes -->
        <env name="PARATEST_PROCESSES" value="1"/>
    </php>
</phpunit>
