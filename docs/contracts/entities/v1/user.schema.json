{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statyba-ecommerce.local/contracts/entities/v1/user.schema.json",
  "title": "UserContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "email",
    "name",
    "roles",
    "meta"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
