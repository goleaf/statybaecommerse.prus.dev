{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statyba-ecommerce.local/contracts/entities/v1/product.schema.json",
  "title": "ProductContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sku",
    "title",
    "description",
    "price",
    "currency",
    "stock",
    "media",
    "categories",
    "attributes",
    "status"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["image", "video", "file"]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "alt": {
            "type": "string"
          },
          "variants": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "uri"
            }
          },
          "primary": {
            "type": "boolean"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "title"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {"type": "number"},
          {"type": "integer"},
          {"type": "boolean"},
          {"type": "null"},
          {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string"},
                {"type": "number"},
                {"type": "integer"},
                {"type": "boolean"},
                {"type": "null"}
              ]
            }
          }
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "inactive",
        "archived"
      ]
    },
    "slug": {
      "type": "string"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "slug": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "logo": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
