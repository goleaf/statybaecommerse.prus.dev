{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statyba-ecommerce.local/contracts/entities/v1/order.schema.json",
  "title": "OrderContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "number",
    "status",
    "items",
    "totals",
    "customer",
    "payments",
    "shipments"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "product", "quantity", "unit_price", "total"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "product": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sku", "title"],
            "properties": {
              "id": {"type": "integer", "minimum": 1},
              "sku": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1}
            }
          },
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price": {"type": "number", "minimum": 0},
          "total": {"type": "number", "minimum": 0},
          "status": {"type": "string"}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subtotal",
        "tax",
        "shipping",
        "discount",
        "total",
        "currency"
      ],
      "properties": {
        "subtotal": {"type": "number", "minimum": 0},
        "tax": {"type": "number", "minimum": 0},
        "shipping": {"type": "number", "minimum": 0},
        "discount": {"type": "number"},
        "total": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "email", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "email": {"type": "string", "format": "email"},
        "name": {"type": "string", "minLength": 1},
        "meta": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "amount", "method"],
        "properties": {
          "status": {"type": "string", "minLength": 1},
          "amount": {"type": "number", "minimum": 0},
          "method": {"type": ["string", "null"]},
          "reference": {"type": ["string", "null"]},
          "processed_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "shipments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {"type": "string", "minLength": 1},
          "carrier": {"type": ["string", "null"]},
          "service": {"type": ["string", "null"]},
          "tracking_number": {"type": ["string", "null"]},
          "tracking_url": {"type": ["string", "null"], "format": "uri"},
          "shipped_at": {"type": ["string", "null"], "format": "date-time"},
          "delivered_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
