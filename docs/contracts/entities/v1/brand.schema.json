{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statyba-ecommerce.local/contracts/entities/v1/brand.schema.json",
  "title": "BrandContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "logo",
    "url"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "logo": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  }
}
