        },
        "is_urgent": {
          "type": "boolean"
        },
        "notification_type": {
          "type": ["string", "null"]
        },
        "formatted_created_at": {
          "type": ["string", "null"]
        },
        "formatted_read_at": {
          "type": ["string", "null"]
        },
        "title": {
          "type": ["string", "null"]
        },
        "message": {
          "type": ["string", "null"]
        },
        "color": {
          "type": ["string", "null"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attachment": {
          "type": ["string", "null"]
        }
      }
    },
    "pagination": {
      "type": "object",
      "required": ["current_page", "last_page", "per_page", "total", "from", "to"],
      "properties": {
        "current_page": {
          "type": "integer",
          "minimum": 1
        },
        "last_page": {
          "type": "integer",
          "minimum": 0
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "from": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "to": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  },
