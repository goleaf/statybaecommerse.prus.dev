// =============================================================================
// OPTIMIZED APP.SCSS - MAXIMUM PERFORMANCE & ORGANIZATION
// =============================================================================

// 1. TAILWIND CSS FRAMEWORK
@use 'tailwindcss';
@use 'sass:color';
@use 'sass:math';
@use 'sass:string';
@use 'sass:list';
@use 'sass:map';
@use 'sass:meta';
@use 'sass:selector';

// 2. SCSS VARIABLES & MIXINS
// =============================================================================

// Color Variables
$primary-color: #0ea5e9; // blue-500npm
$primary-foreground: #ffffff;
$secondary-color: #64748b; // slate-500
$secondary-foreground: #ffffff;
$accent-color: #d946ef; // fuchsia-500
$accent-foreground: #ffffff;

// =============================================================================
// BRAND COLOR SYSTEM - FROM .STYLEREFERENCE
// =============================================================================

// Brand Color Variables - Exact Specifications from .stylereference
$brand-primary: #262523;
$brand-primary-light: #81817d;
$brand-primary-lighter: #b3b2ae;
$brand-secondary: #81817d;
$brand-light: #e3ebd2;

// Primary Colors (aliases for brand colors)
$primary: $brand-primary;
$dark: $brand-primary;
$sage: $brand-light;
$stone: $brand-primary-light;
$ash: $brand-primary-lighter;

$background-color: #f8fafc; // slate-50
$foreground-color: #0f172a; // slate-900
$muted-color: #f1f5f9; // slate-100
$muted-foreground: #64748b; // slate-500
$border-color: #e2e8f0; // slate-200
$input-color: #ffffff;
$ring-color: #0ea5e9; // blue-500

// Dark theme colors
$dark-background: #0f172a; // slate-900
$dark-foreground: #f8fafc; // slate-50
$dark-muted: #1e293b; // slate-800
$dark-muted-foreground: #94a3b8; // slate-400
$dark-border: #334155; // slate-700
$dark-input: #020617; // slate-950

// =============================================================================
// BRAND COLOR UTILITIES - FROM .STYLEREFERENCE
// =============================================================================

// Brand color utility classes
.bg-brand-primary { background-color: $brand-primary !important; }
.bg-brand-primary-light { background-color: $brand-primary-light !important; }
.bg-brand-primary-lighter { background-color: $brand-primary-lighter !important; }
.bg-brand-secondary { background-color: $brand-secondary !important; }
.bg-brand-light { background-color: $brand-light !important; }
.bg-brand-dark { background-color: $brand-primary !important; }

.text-brand-primary { color: $brand-primary !important; }
.text-brand-primary-light { color: $brand-primary-light !important; }
.text-brand-primary-lighter { color: $brand-primary-lighter !important; }
.text-brand-secondary { color: $brand-secondary !important; }
.text-brand-light { color: $brand-light !important; }
.text-brand-dark { color: $brand-primary !important; }

.border-brand-primary { border-color: $brand-primary !important; }
.border-brand-primary-light { border-color: $brand-primary-light !important; }
.border-brand-primary-lighter { border-color: $brand-primary-lighter !important; }
.border-brand-secondary { border-color: $brand-secondary !important; }
.border-brand-light { border-color: $brand-light !important; }
.border-brand-dark { border-color: $brand-primary !important; }

// Brand hover utilities
.hover\:bg-brand-primary:hover { background-color: $brand-primary !important; }
.hover\:bg-brand-primary-light:hover { background-color: $brand-primary-light !important; }
.hover\:bg-brand-primary-lighter:hover { background-color: $brand-primary-lighter !important; }
.hover\:bg-brand-secondary:hover { background-color: $brand-secondary !important; }
.hover\:bg-brand-light:hover { background-color: $brand-light !important; }
.hover\:bg-brand-dark:hover { background-color: $brand-primary !important; }

.hover\:text-brand-primary:hover { color: $brand-primary !important; }
.hover\:text-brand-primary-light:hover { color: $brand-primary-light !important; }
.hover\:text-brand-primary-lighter:hover { color: $brand-primary-lighter !important; }
.hover\:text-brand-secondary:hover { color: $brand-secondary !important; }
.hover\:text-brand-light:hover { color: $brand-light !important; }
.hover\:text-brand-dark:hover { color: $brand-primary !important; }

// Shadow utilities
.shadow-soft { box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06); }
.shadow-medium { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }

// Brand color classes for stylereference layout
.bg-sage { background-color: $sage !important; }
// Preserve explicit text utilities inside sage background
.bg-sage a.text-ash, .bg-sage .text-ash { color: $ash !important; }
.bg-sage a.text-white, .bg-sage .text-white { color: #ffffff !important; }
.bg-sage a:not([class*="text-"]) { color: $dark !important; }
.bg-stone { background-color: $stone !important; }
.bg-ash { background-color: $ash !important; }
.bg-dark { background-color: $dark !important; }

.text-sage { color: $sage !important; }
.text-stone { color: $stone !important; }
.text-ash { color: $ash !important; }
.text-dark { color: $dark !important; }

.border-sage { border-color: $sage !important; }
.border-stone { border-color: $stone !important; }
.border-ash { border-color: $ash !important; }
.border-dark { border-color: $dark !important; }

// Hover states for brand colors
.hover\:bg-sage:hover { background-color: $sage !important; }
.hover\:bg-stone:hover { background-color: $stone !important; }
.hover\:bg-ash:hover { background-color: $ash !important; }
.hover\:bg-dark:hover { background-color: $dark !important; }

.hover\:text-sage:hover { color: $sage !important; }
.hover\:text-stone:hover { color: $stone !important; }
.hover\:text-ash:hover { color: $ash !important; }
.hover\:text-dark:hover { color: $dark !important; }

// Additional utility classes for stylereference layout
.max-w-site { max-width: 1200px; }

// Footer-specific overrides to prevent global SVG interference
footer {
  // Override global SVG styles for footer navigation arrows
  .footer-nav svg,
  .footer-nav-link svg {
    width: 0.75rem !important; // w-3 = 12px
    height: 0.75rem !important;
    margin-top: 0.125rem !important; // mt-0.5
    flex-shrink: 0 !important;
  }
  
  // Override global SVG styles for footer contact icons
  .footer-contact svg {
    width: 1.25rem !important; // w-5 = 20px
    height: 1.25rem !important;
    margin-top: 0.125rem !important; // mt-0.5
    flex-shrink: 0 !important;
  }
  
  // Ensure proper flex alignment for footer links - target the actual link element
  .footer-nav-link {
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    
    // Override any nested span styles that might interfere
    .link-underline {
      display: contents !important;
    }
    
    // Ensure SVG and span are properly aligned
    svg {
      order: 1;
    }
    
    span {
      order: 2;
    }
  }
  
  // Ensure proper flex alignment for footer contact items
  .footer-contact-item {
    display: flex !important;
    align-items: flex-start !important;
    gap: 1rem !important;
  }
}

// Font utilities
.font-montserrat { font-family: 'Montserrat', sans-serif; }

// Spacing Variables
$mobile-padding: 1rem;
$mobile-margin: 0.5rem;
$mobile-font-size: 0.875rem;
$mobile-line-height: 1.5;
$mobile-border-radius: 0.5rem;

// Responsive Breakpoints
$sm-breakpoint: 576px;
$md-breakpoint: 768px;
$lg-breakpoint: 992px;
$xl-breakpoint: 1200px;

// Animation Variables
$transition-fast: 0.15s ease;
$transition-normal: 0.3s ease;
$transition-slow: 0.5s ease;

// Advanced SCSS Functions for Maximum Optimization
@function rem($pixels, $base: 16) {
  @return math.div($pixels, $base) * 1rem;
}

@function em($pixels, $base: 16) {
  @return math.div($pixels, $base) * 1em;
}

@function strip-unit($number) {
  @if meta.type-of($number) == 'number' and not math.is-unitless($number) {
    @return math.div($number, $number * 0 + 1);
  }
  @return $number;
}

@function fluid-size($min-size, $max-size, $min-vw: 320px, $max-vw: 1200px) {
  $min-size: strip-unit($min-size);
  $max-size: strip-unit($max-size);
  $min-vw: strip-unit($min-vw);
  $max-vw: strip-unit($max-vw);
  
  $slope: math.div($max-size - $min-size, $max-vw - $min-vw);
  $intercept: $min-size - $slope * $min-vw;
  
  @return calc(#{$intercept}px + #{$slope} * 100vw);
}

@function z-index($layer) {
  $z-indexes: (
    'modal': 1000,
    'dropdown': 900,
    'overlay': 800,
    'header': 700,
    'footer': 600,
    'content': 1,
    'background': -1
  );
  
  @return map.get($z-indexes, $layer);
}

@function color-shade($color, $percentage) {
  @if $percentage > 0 {
    @return color.scale($color, $lightness: $percentage);
  } @else {
    @return color.scale($color, $lightness: $percentage);
  }
}

// Advanced utility functions
@function get-breakpoint($name) {
  $breakpoints: (
    'xs': 0,
    'sm': 640px,
    'md': 768px,
    'lg': 1024px,
    'xl': 1280px,
    '2xl': 1536px
  );
  
  @return map.get($breakpoints, $name);
}

@function get-spacing($size) {
  $spacings: (
    'xs': 0.25rem,
    'sm': 0.5rem,
    'md': 1rem,
    'lg': 1.5rem,
    'xl': 2rem,
    '2xl': 3rem,
    '3xl': 4rem
  );
  
  @return map.get($spacings, $size);
}

@function get-font-size($size) {
  $font-sizes: (
    'xs': 0.75rem,
    'sm': 0.875rem,
    'base': 1rem,
    'lg': 1.125rem,
    'xl': 1.25rem,
    '2xl': 1.5rem,
    '3xl': 1.875rem,
    '4xl': 2.25rem,
    '5xl': 3rem,
    '6xl': 3.75rem
  );
  
  @return map.get($font-sizes, $size);
}

@function get-shadow($size) {
  $shadows: (
    'sm': 0 1px 2px 0 rgba(0, 0, 0, 0.05),
    'base': 0 1px 3px 0 rgba(0, 0, 0, 0.1),
    'md': 0 4px 6px -1px rgba(0, 0, 0, 0.1),
    'lg': 0 10px 15px -3px rgba(0, 0, 0, 0.1),
    'xl': 0 20px 25px -5px rgba(0, 0, 0, 0.1),
    '2xl': 0 25px 50px -12px rgba(0, 0, 0, 0.25)
  );
  
  @return map.get($shadows, $size);
}

@function get-border-radius($size) {
  $border-radius: (
    'none': 0,
    'sm': 0.125rem,
    'base': 0.25rem,
    'md': 0.375rem,
    'lg': 0.5rem,
    'xl': 0.75rem,
    '2xl': 1rem,
    '3xl': 1.5rem,
    'full': 9999px
  );
  
  @return map.get($border-radius, $size);
}

// Advanced utility functions
@function get-z-index($layer) {
  $z-indexes: (
    'auto': auto,
    '0': 0,
