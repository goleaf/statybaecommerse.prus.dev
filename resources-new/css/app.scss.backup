// Flexbox Utilities with mixins
.flex {
  &-center {
    @include flex-center;
  }
  
  &-between {
    @include flex-between;
  }
  
  &-responsive {
    @include flex-center;
    flex-direction: column;
    gap: var(--mobile-margin);
    
    @include responsive(md) {
      flex-direction: row;
      gap: var(--md-margin);
    }
  }
  
  &-wrap {
    flex-wrap: wrap;
  }
  
  &-nowrap {
    flex-wrap: nowrap;
  }
  
  &-col {
    flex-direction: column;
  }
  
  &-row {
    flex-direction: row;
  }
  
  &-1 {
    flex: 1;
  }
  
  &-auto {
    flex: auto;
  }
  
  &-none {
    flex: none;
  }
}

