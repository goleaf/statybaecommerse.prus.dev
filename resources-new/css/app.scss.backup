    'visibleStroke': visibleStroke,
    'visible': visible,
    'painted': painted,
    'fill': fill,
    'stroke': stroke,
    'all': all,
    'bounding-box': bounding-box
  );
  
  @return map.get($pointer-events, $events);
}

@function get-visibility($visibility) {
  $visibilities: (
