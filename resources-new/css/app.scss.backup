    'help': help,
    'pointer': pointer,
    'progress': progress,
    'wait': wait,
    'cell': cell,
    'crosshair': crosshair,
    'text': text,
    'vertical-text': vertical-text,
    'alias': alias,
    'copy': copy,
    'move': move,
    'no-drop': no-drop,
    'not-allowed': not-allowed,
    'grab': grab,
    'grabbing': grabbing,
    'all-scroll': all-scroll,
    'col-resize': col-resize,
    'row-resize': row-resize,
    'n-resize': n-resize,
    'e-resize': e-resize,
    's-resize': s-resize,
    'w-resize': w-resize,
    'ne-resize': ne-resize,
