    'none': none,
    'context-menu': context-menu,
    'help': help,
    'pointer': pointer,
    'progress': progress,
    'wait': wait,
    'cell': cell,
    'crosshair': crosshair,
    'text': text,
    'vertical-text': vertical-text,
    'alias': alias,
    'copy': copy,
    'move': move,
    'no-drop': no-drop,
    'not-allowed': not-allowed,
    'grab': grab,
    'grabbing': grabbing,
    'all-scroll': all-scroll,
    'col-resize': col-resize,
    'row-resize': row-resize,
    'n-resize': n-resize,
    'e-resize': e-resize,
    's-resize': s-resize,
    'w-resize': w-resize,
    'ne-resize': ne-resize,
    'nw-resize': nw-resize,
    'se-resize': se-resize,
    'sw-resize': sw-resize,
    'ew-resize': ew-resize,
    'ns-resize': ns-resize,
    'nesw-resize': nesw-resize,
    'nwse-resize': nwse-resize,
    'zoom-in': zoom-in,
    'zoom-out': zoom-out
  );
  
  @return map.get($cursors, $cursor);
}

@function get-resize($resize) {
  $resizes: (
    'none': none,
    'both': both,
    'horizontal': horizontal,
    'vertical': vertical,
    'block': block,
    'inline': inline
  );
  
  @return map.get($resizes, $resize);
}

@function get-user-select($select) {
  $user-selects: (
    'none': none,
    'auto': auto,
    'text': text,
    'contain': contain,
    'all': all
