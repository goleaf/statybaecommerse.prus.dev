{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://prus.dev/contracts/brand.v1.schema.json",
    "title": "Brand contract v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["contract", "version", "data", "meta"],
    "properties": {
        "contract": {
            "const": "brand"
        },
        "version": {
            "type": "string",
            "pattern": "^v1(\\.\\d+)?$"
        },
        "data": {
            "oneOf": [
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/brand"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "brand": {
                            "$ref": "#/$defs/brand"
                        },
                        "brands": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/brand"
                            }
                        },
                        "item": {
                            "$ref": "#/$defs/brand"
                        },
                        "items": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/brand"
                            }
                        }
                    },
                    "anyOf": [
                        {
                            "required": ["brand"]
                        },
                        {
                            "required": ["brands"]
                        },
                        {
                            "required": ["item"]
                        },
                        {
                            "required": ["items"]
                        }
                    ]
                }
            ]
        },
        "meta": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "total": {
                    "type": ["integer", "null"],
                    "minimum": 0
                }
            }
        }
    },
    "$defs": {
        "brand": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "slug", "name", "links"],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "slug": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": ["string", "null"]
                },
                "website": {
                    "type": ["string", "null"],
                    "format": "uri"
                },
                "products_count": {
                    "type": ["integer", "null"],
                    "minimum": 0
                },
                "links": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["self"],
                    "properties": {
                        "self": {
                            "type": "string",
                            "format": "uri"
                        }
                    }
                }
            }
        }
    }
}
