{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://prus.dev/contracts/user.v1.schema.json",
    "title": "User contract v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["contract", "version", "data", "meta"],
    "properties": {
        "contract": {
            "const": "user"
        },
        "version": {
            "type": "string",
            "pattern": "^v1(\\.\\d+)?$"
        },
        "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "item": {
                    "$ref": "#/$defs/user"
                }
            },
            "required": ["item"]
        },
        "meta": {
            "type": "object",
            "additionalProperties": true
        }
    },
    "$defs": {
        "user": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "full_name", "status", "metrics", "preferences", "links"],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "first_name": {
                    "type": ["string", "null"]
                },
                "last_name": {
                    "type": ["string", "null"]
                },
                "full_name": {
                    "type": "string"
                },
                "initials": {
                    "type": ["string", "null"]
                },
                "avatar_url": {
                    "type": ["string", "null"],
                    "format": "uri"
                },
                "contact": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "email": {
                            "type": ["string", "null"],
                            "format": "email"
                        },
                        "phone": {
                            "type": ["string", "null"]
                        }
                    }
                },
                "status": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "is_email_verified",
                        "is_phone_verified",
                        "has_two_factor",
                        "is_on_trial",
                        "has_active_subscription"
                    ],
                    "properties": {
                        "is_email_verified": {
                            "type": "boolean"
                        },
                        "is_phone_verified": {
                            "type": "boolean"
                        },
                        "has_two_factor": {
                            "type": "boolean"
                        },
                        "is_on_trial": {
                            "type": "boolean"
                        },
                        "has_active_subscription": {
                            "type": "boolean"
                        }
                    }
                },
                "metrics": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "orders_count",
                        "reviews_count",
                        "total_spent",
                        "average_order_value"
                    ],
                    "properties": {
                        "orders_count": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "reviews_count": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "total_spent": {
                            "type": "number"
                        },
                        "average_order_value": {
                            "type": "number"
                        },
                        "last_order_date": {
                            "type": ["string", "null"],
                            "format": "date-time"
                        }
                    }
                },
                "preferences": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "preferred_locale": {
                            "type": ["string", "null"]
                        },
                        "timezone": {
                            "type": ["string", "null"]
                        },
                        "locale_text": {
                            "type": ["string", "null"]
                        },
                        "roles_label": {
                            "type": ["string", "null"]
                        }
                    }
                },
                "addresses": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "orders": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "wishlist": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "links": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["self"],
                    "properties": {
                        "self": {
                            "type": "string",
                            "format": "uri"
                        }
                    }
                }
            }
        }
    }
}
