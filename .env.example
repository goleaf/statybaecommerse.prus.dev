# Statybos E-commerce environment template
# Duplicate this file to .env and fill secrets locally. All values are safe defaults or placeholders.

APP_CURRENCY=EUR
APP_DEBUG=true
APP_ENV=local
APP_FAKER_LOCALE=en_US
APP_FALLBACK_LOCALE=en
APP_KEY=base64:your-app-key
APP_LOCALE=lt
APP_MAINTENANCE_DRIVER=file
CACHE_STORE=file

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_ENCRYPT=false
DB_FOREIGN_KEYS=true
DB_HOST=127.0.0.1
DB_PASSWORD=your-database-password
DB_PORT=3306
DB_QUEUE=default
DB_QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
DB_QUEUE_TABLE=jobs
DB_SOCKET=
DB_SYNCHRONOUS=2
DB_TEMP_STORE=2
DB_TRUST_SERVER_CERTIFICATE=false
DB_URL=
DB_USERNAME=forge
DEBUGBAR_EDITOR=phpstorm
DEBUGBAR_ENABLED=true
DEBUGBAR_LOCAL_SITES_PATH=
DEBUGBAR_REMOTE_SITES_PATH=
DEBUGBAR_THEME=auto
DEFAULT_ZONE=Europe/Vilnius
DISABLE_DEBUG_TOOLS=false

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FILAMENT_FILESYSTEM_DISK=public
FILESYSTEM_DISK=public
FILESYSTEM_DRIVER=local
FORCE_MEDIA_LIBRARY_LAZY_LOADING=true

LOG_CHANNEL=stack
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug

# Mail configuration (log transport keeps local bootstrapping self-contained)

MAIL_EHLO_DOMAIN=localhost
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME=${APP_NAME}
MAIL_HOST=127.0.0.1
MAIL_LOG_CHANNEL=null
MAIL_MAILER=log
MAIL_PASSWORD=
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs
MAIL_URL=
MAIL_USERNAME=
# Media library defaults (safe conversions without extra toggles)
MEDIA_DISK=public
MEDIA_DOWNLOADER_SSL=true
MEDIA_MAX_UPLOAD=2048
MEDIA_PREFIX=media
MEDIA_QUEUE=media
MEDIA_TEMPORARY_URL_DEFAULT_LIFETIME=5
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MYSQL_ATTR_SSL_CA=

PAPERTRAIL_PORT=12345
PAPERTRAIL_URL=logs.papertrailapp.com
PHP_CLI_SERVER_WORKERS=2
POSTMARK_MESSAGE_STREAM_ID=outbound
POSTMARK_TOKEN=your-postmark-token
# Queue configuration (database driver works without Redis; toggle when scaling)
QUEUE_CONNECTION=database
QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true
QUEUE_CONVERSIONS_BY_DEFAULT=true
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_DEAD_LETTER_ENABLED=true
QUEUE_DEAD_LETTER_CONNECTION=database
QUEUE_DEAD_LETTER_QUEUE=dead-letter
QUEUE_FAILURE_ALERTS=true
QUEUE_FAILURE_SPIKE_THRESHOLD=5
QUEUE_FAILURE_SPIKE_WINDOW=300
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_DB=1
REDIS_CACHE_LOCK_CONNECTION=cache
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_DB=0
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PERSISTENT=false
REDIS_PORT=6379
REDIS_PREFIX=statybaecommerse_
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_RETRY_AFTER=90
REDIS_URL=
REDIS_USERNAME=

REPORTS_CACHE_ENABLED=true
REPORTS_CACHE_TTL=3600
REPORTS_CHUNK_SIZE=1000
REPORTS_CURRENCY=EUR
REPORTS_DAILY_SUMMARY=false
REPORTS_DB_CONNECTION=default
REPORTS_DEFAULT_LOCALE=lt
REPORTS_ERROR_EMAIL=
REPORTS_IP_WHITELIST=
REPORTS_LAZY_LOADING=true
REPORTS_MAX_EXPORT=50000
REPORTS_MAX_RECORDS=10000
REPORTS_MAX_REQUESTS=60
REPORTS_MEMORY_LIMIT=512M
REPORTS_POLLING_ENABLED=true
REPORTS_QUERY_TIMEOUT=30
REPORTS_RATE_LIMIT_ENABLED=true
REPORTS_RATE_LIMIT_WINDOW=1
REPORTS_SLOW_QUERY_THRESHOLD=5
REPORTS_TIMEZONE=Europe/Vilnius
REPORTS_USE_READ_REPLICA=false
REPORTS_WIDGET_REFRESH=30
RESEND_KEY=your-resend-api-key
REVIEWS_SEED_TOTAL=1000
SEARCH_DRIVER=database
SCOUT_ENABLED=false
SCOUT_DRIVER=collection
SCOUT_QUEUE=false
SEED_ATTRS_PER_PRODUCT_MAX=6
SEED_ATTRS_PER_PRODUCT_MIN=3
SEED_CATEGORIES_PER_PRODUCT=4
SEED_CHUNK_SIZE=50
SEED_IMAGES_PER_PRODUCT_MAX=5
SEED_IMAGES_PER_PRODUCT_MIN=2
SEED_PRODUCTS_PER_BRAND=12
SESSION_CONNECTION=sqlite
SESSION_DOMAIN=
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_HTTP_ONLY=true
SESSION_LIFETIME=120
SESSION_PARTITIONED_COOKIE=false
SESSION_PATH=/
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_STORE=sessions
SESSION_TABLE=sessions
FILAMENT_ENABLED_TWO_FACTOR=true
FILAMENT_PREFIX=admin

VITE_APP_NAME=${APP_NAME}

# Montonio (sandbox demo defaults for local development)
MONTONIO_ACCESS_KEY=
MONTONIO_SECRET_KEY=
MONTONIO_SANDBOX=true
MONTONIO_DEMO_MODE=true

# Saskaita invoice integration
INVOICES_ENABLED=false
INVOICES_BASE_URL=https://saskaita.vercel.app
INVOICES_API_TOKEN=
INVOICES_API_AUTH_BEARER=
INVOICES_SELLER_WEBSITE=
INVOICES_TIMEOUT_SECONDS=20
INVOICES_RETRY_TIMES=3
INVOICES_RETRY_SLEEP_MS=250
INVOICES_DEFAULT_TYPE=sf
INVOICES_DEFAULT_TAX_RATE=21
INVOICES_DEFAULT_TAX_TYPE=excluded
INVOICES_DEFAULT_LANGUAGE=lt
