# Statybos E-commerce environment template
# Duplicate this file to .env and fill secrets locally. All values are safe defaults or placeholders.

API_RATE_LIMIT_AUTOCOMPLETE=30,1
API_RATE_LIMIT_DEFAULT=60,1
API_RATE_LIMIT_NOTIFICATIONS=120,1
APP_CURRENCY=EUR
APP_DEBUG=true
APP_ENV=local
APP_FAKER_LOCALE=en_US
APP_FALLBACK_LOCALE=en
APP_KEY=base64:your-app-key
APP_LOCALE=lt
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_ENCRYPT=false
DB_FOREIGN_KEYS=true
DB_HOST=127.0.0.1
DB_JOURNAL_MODE=wal
DB_MMAP_SIZE=134217728
DB_PAGE_SIZE=4096
DB_PASSWORD=your-database-password
DB_PORT=3306
DB_QUEUE=default
DB_QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
DB_QUEUE_TABLE=jobs
DB_SOCKET=
DB_SYNCHRONOUS=2
DB_TEMP_STORE=2
DB_TRUST_SERVER_CERTIFICATE=false
DB_URL=
DB_USERNAME=forge
DEBUGBAR_EDITOR=phpstorm
DEBUGBAR_ENABLED=true
DEBUGBAR_LOCAL_SITES_PATH=
DEBUGBAR_REMOTE_SITES_PATH=
DEBUGBAR_THEME=auto
DEFAULT_ZONE=Europe/Vilnius
DISABLE_DEBUG_TOOLS=false
DUSK_DRIVER_URL=http://127.0.0.1:9515
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=
ENABLE_MEDIA_LIBRARY_VAPOR_UPLOADS=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FILAMENT_FILESYSTEM_DISK=public
FILESYSTEM_DISK=public
FILESYSTEM_DRIVER=local
FORCE_MEDIA_LIBRARY_LAZY_LOADING=true
HORIZON_DOMAIN=
HORIZON_PATH=horizon
IMAGE_DRIVER=gd
LOG_CHANNEL=stack
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_PAPERTRAIL_HANDLER=Monolog\Handler\SyslogUdpHandler
LOG_SLACK_EMOJI=:construction_worker:
LOG_SLACK_USERNAME=Statybos Bot
LOG_SLACK_WEBHOOK_URL=
LOG_STACK=
LOG_STDERR_FORMATTER=Monolog\Formatter\LineFormatter
LOG_SYSLOG_FACILITY=local0
# Mail configuration (log transport keeps local bootstrapping self-contained)
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_BASE_URL=https://api.mailchimp.com/3.0
MAILCHIMP_LIST_ID=your-mailchimp-list-id
MAIL_EHLO_DOMAIN=localhost
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME=${APP_NAME}
MAIL_HOST=127.0.0.1
MAIL_LOG_CHANNEL=null
MAIL_MAILER=log
MAIL_PASSWORD=
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs
MAIL_URL=
MAIL_USERNAME=
# Media library defaults (safe conversions without extra toggles)
MEDIA_DISK=public
MEDIA_DOWNLOADER_SSL=true
MEDIA_MAX_UPLOAD=2048
MEDIA_PREFIX=media
MEDIA_QUEUE=media
MEDIA_TEMPORARY_URL_DEFAULT_LIFETIME=5
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MYSQL_ATTR_SSL_CA=
OPTIMIZE_FOR_CLI=false
PAPERTRAIL_PORT=12345
PAPERTRAIL_URL=logs.papertrailapp.com
PHP_CLI_SERVER_WORKERS=2
POSTMARK_MESSAGE_STREAM_ID=outbound
POSTMARK_TOKEN=your-postmark-token
# Queue configuration (database driver works without Redis; toggle when scaling)
QUEUE_CONNECTION=database
QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true
QUEUE_CONVERSIONS_BY_DEFAULT=true
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_DEAD_LETTER_ENABLED=true
QUEUE_DEAD_LETTER_CONNECTION=database
QUEUE_DEAD_LETTER_QUEUE=dead-letter
QUEUE_FAILURE_ALERTS=true
QUEUE_FAILURE_SPIKE_THRESHOLD=5
QUEUE_FAILURE_SPIKE_WINDOW=300
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_DB=1
REDIS_CACHE_LOCK_CONNECTION=cache
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_DB=0
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PERSISTENT=false
REDIS_PORT=6379
REDIS_PREFIX=statybaecommerse_
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_RETRY_AFTER=90
REDIS_URL=
REDIS_USERNAME=

TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_RATIO=1.0

REPORTS_CACHE_ENABLED=true
REPORTS_CACHE_TTL=3600
REPORTS_CHUNK_SIZE=1000
REPORTS_CURRENCY=EUR
REPORTS_DAILY_SUMMARY=false
REPORTS_DB_CONNECTION=default
REPORTS_DEFAULT_LOCALE=lt
REPORTS_ERROR_EMAIL=
REPORTS_IP_WHITELIST=
REPORTS_LAZY_LOADING=true
REPORTS_MAX_EXPORT=50000
REPORTS_MAX_RECORDS=10000
REPORTS_MAX_REQUESTS=60
REPORTS_MEMORY_LIMIT=512M
REPORTS_POLLING_ENABLED=true
REPORTS_QUERY_TIMEOUT=30
REPORTS_RATE_LIMIT_ENABLED=true
REPORTS_RATE_LIMIT_WINDOW=1
REPORTS_SLOW_QUERY_THRESHOLD=5
REPORTS_TIMEZONE=Europe/Vilnius
REPORTS_USE_READ_REPLICA=false
REPORTS_WIDGET_REFRESH=30
RESEND_KEY=your-resend-api-key
REVIEWS_SEED_TOTAL=1000
SEARCH_DRIVER=database
SCOUT_ENABLED=false
SCOUT_DRIVER=collection
SCOUT_QUEUE=false
SEED_ATTRS_PER_PRODUCT_MAX=6
SEED_ATTRS_PER_PRODUCT_MIN=3
SEED_CATEGORIES_PER_PRODUCT=4
SEED_CHUNK_SIZE=50
SEED_IMAGES_PER_PRODUCT_MAX=5
SEED_IMAGES_PER_PRODUCT_MIN=2
SEED_PRODUCTS_PER_BRAND=12
SESSION_CONNECTION=database
SESSION_DOMAIN=
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_HTTP_ONLY=true
SESSION_LIFETIME=120
SESSION_PARTITIONED_COOKIE=false
SESSION_PATH=/
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_STORE=sessions
SESSION_TABLE=sessions
SHIPPING_DEFAULT_RATE=15.00
SHOPPER_ENABLED_TWO_FACTOR=true
SHOPPER_PREFIX=cpanel
SLACK_BOT_USER_DEFAULT_CHANNEL=#alerts
SLACK_BOT_USER_OAUTH_TOKEN=xoxb-your-slack-token
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account
SQS_QUEUE=default
SQS_SUFFIX=
SYSTEM_USER_EMAIL=system@example.com
SYSTEM_USER_ID=1
SYSTEM_USER_NAME=System User
TAX_DEFAULT_RATE=0.21
TELESCOPE_BATCH_WATCHER=true
TELESCOPE_CACHE_WATCHER=true
TELESCOPE_CLIENT_REQUEST_WATCHER=false
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_DOMAIN=
TELESCOPE_DRIVER=database
TELESCOPE_DUMP_WATCHER=true
TELESCOPE_DUMP_WATCHER_ALWAYS=false
TELESCOPE_ENABLED=false
TELESCOPE_EVENT_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_GATE_WATCHER=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_MODEL_WATCHER=true
TELESCOPE_NOTIFICATION_WATCHER=true
TELESCOPE_PATH=telescope
TELESCOPE_QUERY_WATCHER=true
TELESCOPE_QUEUE=default
TELESCOPE_QUEUE_CONNECTION=database
TELESCOPE_QUEUE_DELAY=0
TELESCOPE_REDIS_WATCHER=false
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_RESPONSE_SIZE_LIMIT=64
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_VIEW_WATCHER=true
TERMINAL_OPTIMIZED=false
VITE_APP_NAME=${APP_NAME}
