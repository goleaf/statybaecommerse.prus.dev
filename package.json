{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "laravel-app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@11.4.2",
    "engines": {
        "node": "20.19.4",
        "npm": "11.4.2"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "preview": "vite preview",
        "mcp:filament": "node mcp/filament-docs-server.js",
        "test": "php artisan test",
        "test:e2e": "playwright test",
        "e2e:smoke": "node scripts/e2e-smoke.mjs",
        "e2e:routes": "node scripts/check-routes.mjs",
        "e2e:console": "node scripts/check-console.mjs",
        "lighthouse:audit": "node scripts/lighthouse.mjs",
        "lint:commits": "commitlint --from=HEAD~1",
        "lint:eslint": "eslint --max-warnings=0 \"resources/js/**/*.{js,jsx,ts,tsx}\"",
        "lint:prettier": "prettier --check \"resources/**/*.{css,js,jsx,ts,tsx,json,md}\"",
        "lint": "npm run lint:prettier && npm run lint:eslint",
        "prepare": "husky install",
        "release": "release-please release --manifest .release-please-manifest.json --config release-please-config.json",
        "release:pr": "release-please release-pr --manifest .release-please-manifest.json --config release-please-config.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@eslint/js": "^9.17.0",
        "globals": "^15.14.0",
        "@modelcontextprotocol/sdk": "1.0.0",
        "@playwright/test": "1.47.2",
        "@tailwindcss/aspect-ratio": "0.4.2",
        "@tailwindcss/forms": "0.5.10",
        "@tailwindcss/postcss": "4.1.12",
        "@tailwindcss/typography": "0.5.16",
        "@tailwindcss/vite": "4.1.12",
        "autoprefixer": "10.4.21",
        "axios": "1.11.0",
        "cheerio": "1.0.0",
        "concurrently": "9.0.1",
        "husky": "^9.1.7",
        "eslint": "^9.17.0",
        "laravel-vite-plugin": "2.0.0",
        "node-fetch": "3.3.2",
        "playwright": "1.47.2",
        "lighthouse": "12.4.0",
        "postcss": "^8.4.49",
        "prettier": "^3.4.2",
        "release-please": "^17.1.3",
        "sass": "1.77.8",
        "sass-embedded": "1.92.1",
        "tailwindcss": "4.1.12",
        "vite": "7.1.3"
    },
    "dependencies": {
        "@fontsource/figtree": "5.2.8",
        "@fontsource/instrument-sans": "5.2.6",
        "@fontsource/inter": "5.2.6",
        "@fontsource/space-grotesk": "5.2.8",
        "shiki": "3.12.0",
        "sortablejs": "1.15.6",
        "treeselectjs": "0.13.1"
    },
    "browserslist": [
        "last 2 versions",
        ">= 1%",
        "not dead",
        "not ie <= 11"
    ]
}
