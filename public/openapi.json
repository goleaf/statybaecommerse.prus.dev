{
  "openapi": "3.0.3",
  "info": {
    "title": "Collection API",
    "version": "1.0.0",
    "description": "Public endpoints that power the statybae collections experience."
  },
  "paths": {
    "/collections/api/search": {
      "get": {
        "summary": "List visible collections",
        "description": "Returns up to 20 visible collections with optional filtering by search term or flags.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Full-text search across the collection name, description, and slug."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "required": false,
            "description": "Optional limit for the number of collections to return."
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "required": false,
            "description": "Optional offset that can be used for client-side pagination."
          },
          {
            "name": "display_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "grid",
                "list"
              ]
            },
            "required": false,
            "description": "Filter the results down to a particular display type."
          },
          {
            "name": "has_products",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "When true, only collections that currently contain products are returned."
          }
        ],
        "responses": {
          "200": {
            "description": "Collection search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/collections/api/by-type/{type}": {
      "get": {
        "summary": "List collections by type",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "manual",
                "automatic"
              ]
            },
            "description": "Collection automation type to filter by."
          }
        ],
        "responses": {
          "200": {
            "description": "Collections filtered by type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/collections/api/with-products": {
      "get": {
        "summary": "List collections that contain products",
        "responses": {
          "200": {
            "description": "Collections that currently have products",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/collections/api/popular": {
      "get": {
        "summary": "List popular collections",
        "responses": {
          "200": {
            "description": "Popular collections sorted by product count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/collections/api/statistics": {
      "get": {
        "summary": "Collection statistics",
        "responses": {
          "200": {
            "description": "Aggregated statistics for all collections",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionStatisticsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/collections/{collection}/products": {
      "get": {
        "summary": "List products within a collection",
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Collection slug to retrieve products for."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "1-based page to return."
          },
          {
            "name": "brand_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Filter results to a specific brand id."
          },
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Filter results to a specific category id."
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": 0
            },
            "description": "Lowest price (inclusive) allowed in the response."
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": 0
            },
            "description": "Highest price (inclusive) allowed in the response."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional sort alias (for example, name_asc)."
          }
        ],
        "responses": {
          "200": {
            "description": "Collection products paginated list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionProductListResponse"
                }
              }
            }
          },
          "404": {
            "description": "Collection not found or not visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CollectionSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "is_visible",
          "is_automatic",
          "display_type",
          "products_count"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "is_visible": {
            "type": "boolean"
          },
          "is_automatic": {
            "type": "boolean"
          },
          "display_type": {
            "type": "string"
          },
          "products_count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CollectionListResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionSummary"
            }
          }
        }
      },
      "CollectionStatisticsResponse": {
        "type": "object",
        "required": [
          "total_collections",
          "visible_collections",
          "automatic_collections",
          "manual_collections",
          "collections_with_products",
          "collections_without_products"
        ],
        "properties": {
          "total_collections": {
            "type": "integer",
            "format": "int32"
          },
          "visible_collections": {
            "type": "integer",
            "format": "int32"
          },
          "automatic_collections": {
            "type": "integer",
            "format": "int32"
          },
          "manual_collections": {
            "type": "integer",
            "format": "int32"
          },
          "collections_with_products": {
            "type": "integer",
            "format": "int32"
          },
          "collections_without_products": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProductSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "description",
          "brand",
          "categories",
          "media"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "brand": {
            "type": "string",
            "nullable": true
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "PaginationLinks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": [
          "current_page",
          "last_page",
          "per_page",
          "total"
        ],
        "properties": {
          "current_page": {
            "type": "integer",
            "format": "int32"
          },
          "last_page": {
            "type": "integer",
            "format": "int32"
          },
          "per_page": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CollectionProductListResponse": {
        "type": "object",
        "required": [
          "data",
          "links",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductSummary"
            }
          },
          "links": {
            "$ref": "#/components/schemas/PaginationLinks"
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
