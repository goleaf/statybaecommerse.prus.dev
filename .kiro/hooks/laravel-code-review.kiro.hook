{
  "enabled": true,
  "name": "Laravel Code Review",
  "description": "Runs opinionated code reviews for PHP changes, focusing on correctness, security, performance, and adherence to Laravel conventions.",
  "version": "2.0",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "app/**/*.php",
      "routes/*.php",
      "database/**/*.php",
      "tests/**/*.php",
      "config/*.php"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "LARAVEL CODE REVIEW\n\nCONTEXT: PHP file was modified. Review against project standards.\n\nPROJECT STACK: Laravel 12, Filament v4, multi-tenant architecture, quality gates via Pint/PHPStan/Pest.\n\nREVIEW CHECKLIST:\n- **Correctness**: Validation, policies, null/edge cases, type safety, mass assignment, query safety\n- **Architecture**: Reuse scopes/traits/services, avoid duplication, follow naming/routing conventions\n- **Performance**: Eager loading vs N+1, pagination, caching opportunities, lightweight views/Livewire\n- **Security**: Authorization on mutations, sanitized inputs/outputs, sensitive data handling\n- **Localization**: No hardcoded strings, proper translation keys (lt/en)\n- **Accessibility**: ARIA/focus for UI changes, dark mode compatibility\n- **Testing**: Coverage recommendations for the changes\n\nOUTPUT:\n1) **Findings** by severity with file/line references\n2) **Risk Summary** and potential regressions\n3) **Recommendations** with specific fixes\n4) **Implementation** of critical fixes\n\nMaintain backward compatibility and existing conventions."
  },
  "shortName": "laravel-code-review"
}